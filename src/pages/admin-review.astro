---
const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;
---
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>审核面板</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{max-width:900px;margin:30px auto;padding:0 20px;font-family:system-ui}
.item{border:1px solid #ddd;border-radius:8px;padding:16px;margin:10px 0}
.btns button{margin-right:8px;padding:6px 12px;border:none;border-radius:4px;cursor:pointer}
.pass{background:#22c55e;color:white}
.reject{background:#ef4444;color:white}
</style>
</head>
<body>
<h2>待审核列表</h2>
<div id="list"></div>
<script>
const SUPABASE_URL = import.meta.env.SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.SUPABASE_ANON_KEY;
const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm')
const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY)

async function load(){
  const {data,error} = await supabase.from('videos').select('*').eq('status','pending')
  if(error) return console.error(error)
  const wrap = document.getElementById('list')
  wrap.innerHTML = ''
  data.forEach(row=>{
    const div = document.createElement('div')
    div.className='item'
    div.innerHTML = `
      <h3>${row.title}</h3>
      <p>${row.desc || '无简介'}</p>
      <p><a href="${row.video_url}" target="_blank">视频链接</a></p>
      <div class="btns">
        <button class="pass" data-id="${row.id}">通过</button>
        <button class="reject" data-id="${row.id}">驳回</button>
      </div>
    `
    wrap.appendChild(div)
  })
  document.querySelectorAll('.pass').forEach(btn=>{
    btn.onclick = async ()=>{
      const id = btn.dataset.id
      await supabase.from('videos').update({status:'pass'}).eq('id',id)
      load()
    }
  })
  document.querySelectorAll('.reject').forEach(btn=>{
    btn.onclick = async ()=>{
      const id = btn.dataset.id
      await supabase.from('videos').update({status:'reject'}).eq('id',id)
      load()
    }
  })
}
load()
</script>
</body>
</html>
